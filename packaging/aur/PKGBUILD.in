# Miyu（托盘程序 miyu-app）的 AUR 包（施工 DT-6；AP-2 从 miyu-desktop-bin 改名）：直接拆发版里的 deb。发版的流水线填 pkgver、sha256sums 两行，传进发版；推到 AUR 由项目主人做。
# 带了核心（/usr/bin/miyu），和单独装的 miyu 包冲突。
pkgname=miyu-app-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Miyu: a tray icon that runs Miyu and opens its web interface in your browser, including the Miyu core"
arch=('x86_64')
url="https://github.com/miyu-agent/miyu-app"
license=('AGPL-3.0-or-later')
depends=('gtk3' 'bubblewrap')
provides=('miyu-app' 'miyu')
conflicts=('miyu-app' 'miyu' 'miyu-desktop' 'miyu-desktop-bin')
replaces=('miyu-desktop-bin')
options=('!strip' '!debug')
source=("https://github.com/miyu-agent/miyu-app/releases/download/v${pkgver}/miyu-app_${pkgver}_amd64.deb")
sha256sums=('@SHA256@')

package() {
    bsdtar -xf data.tar.* -C "$pkgdir"
}
